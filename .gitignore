*.egg

# Environment variables
.env
.env.local
.env.*.local
backend/.env
handball-stats/.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js
handball-stats/.next/
handball-stats/out/
handball-stats/build/
handball-stats/node_modules/

# Testing
coverage/
.pytest_cache/

# Docker
*.log

# OS
Thumbs.db
.DS_Store

# Backup files
*.bak
*.backup
*.tmp
